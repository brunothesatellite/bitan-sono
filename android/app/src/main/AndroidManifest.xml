<?xml version="1.0" encoding="utf-8"?>
<!--
  bitan·sono — coquille Android.

  Deux façons d'autoriser l'accès au sonomètre :
    - l'utilisateur lance l'application et appuie sur « Connecter » (demande
      d'autorisation à la volée) ;
    - il branche l'appareil en OTG : Android propose alors directement
      bitan·sono dans la liste, grâce au filtre ci-dessous.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Le téléphone se comporte en hôte USB (OTG). -->
    <uses-feature android:name="android.hardware.usb.host" android:required="true" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:hardwareAccelerated="true"
        android:allowBackup="true"
        android:usesCleartextTraffic="false"
        android:supportsRtl="false"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Branché sur le port USB : l'application est proposée. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>
    </application>
</manifest>
